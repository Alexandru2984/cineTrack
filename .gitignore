# Environment
.env
.env.prod

# Credentials handed over for a task and left in the working tree. Patterns, not
# names: `google-services.json` was dropped in, staged by a `git add -A`, pushed,
# and caught by the secret scanner rather than by anything here. Anything that
# reads as a key belongs to the machine, never to the repository.
*api_key*.txt
*_key.json
*credentials*.json
*.pem
*.p12
*.keystore

# Rust / Backend
backend/target/

# Python tooling
__pycache__/
*.py[cod]

# Node / Frontend
frontend/node_modules/
frontend/dist/

# Docker volumes
postgres_data/

# IDE and agent tooling
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# SSL certs
nginx/ssl/

# Personal TV Time export/import data (contains PII: tokens, IPs, password hashes) — never commit
tvtime_data/
# Glob, not `.bak.*`: a backup named `.env.prod.bak-<date>` slipped past the
# dot-only pattern and showed up as untracked, one `git add -A` from leaking.
.env.prod.bak*
bench/results/
bench-summary.json
ops/alertmanager/alertmanager.generated.yml
ops/alertmanager/smtp_password.generated
ops/prometheus/metrics_token.generated

# Credentials dropped in the repository root.
#
# Named by class, not by the filename that last caught us out. The Expo build
# token arrived as `expo_token.txt`; its replacement arrived as `expo_pat.txt`
# and matched nothing here, because a list that only ever learns the last name
# is always one rename behind. This is the third time a credential has landed
# in the working tree under a name the guard did not know.
#
# Anchored to the root with a leading slash, so source files that merely
# contain one of these words — `frontend/src/lib/oneTimeToken.ts`, for one —
# are untouched.
/*token*
/*pat*.txt
/*secret*
/*credential*
/*.key
/*.pem
