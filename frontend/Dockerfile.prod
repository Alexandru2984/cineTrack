FROM node:26-alpine@sha256:e88a35be04478413b7c71c455cd9865de9b9360e1f43456be5951032d7ac1a66 AS builder
WORKDIR /app
RUN npm install --global npm@12.0.1 --no-audit --no-fund
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL=""
ARG VITE_USE_R2_IMAGES="false"
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_USE_R2_IMAGES=$VITE_USE_R2_IMAGES
RUN npm run build

FROM nginx:1.31-alpine@sha256:7068961d45b07b2af510ac002e9daa63a1d3eba2111202d6768798690800fffd
# `libexpat` is upgraded rather than waited for. The pinned base still ships
# 2.8.2-r0, which two HIGH advisories now cover — CVE-2026-66046 and
# CVE-2026-76641 — and upstream has not rebuilt the tag. Alpine 3.24 main
# already carries the fix, so the image takes it directly instead of leaving
# every pull request blocked on somebody else's release schedule.
#
# The scan is what found this, and it found it on branches that changed nothing
# related: a Trivy run is dated, so a base image that passed yesterday fails
# today. That is the check working.
#
# `libuuid` joined it on 2026-09-05, and the daily sweep is what noticed: seven
# HIGH advisories against util-linux 2.42.1-r0 — CVE-2026-53612 through
# CVE-2026-78410, the first of them a TOCTOU in `mount` — all fixed in
# 2.42.3-r0. Same reasoning, same remedy: take the fix from Alpine main rather
# than wait for the base tag to be rebuilt.
RUN apk add --no-cache --upgrade 'libexpat>=2.8.4-r0' 'libuuid>=2.42.3-r0'
# Asserted after the upgrade, not before. These pins exist so a base image whose
# contents drift breaks the build loudly instead of shipping different software
# under the same digest; an assertion that ran first would describe the image we
# started from rather than the one being shipped.
RUN apk info --exists 'c-ares=1.34.8-r0' && \
    apk info --exists 'libexpat=2.8.4-r0' && \
    apk info --exists 'libuuid=2.42.3-r0' && \
    apk info --exists 'curl=8.21.0-r0' && \
    apk info --exists 'libcurl=8.21.0-r0'
# Stamped the same way as the backend image. Without it the deploy-drift check
# has one revision to speak for two independently deployed artifacts, and gets
# it wrong in both directions: a frontend-only release leaves the backend label
# behind and raises an alert with nothing to fix, while a backend-only release
# after a frontend change reports "up to date" over a stale bundle.
ARG GIT_REVISION=unknown
LABEL org.opencontainers.image.revision="${GIT_REVISION}"

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx-main.conf /etc/nginx/nginx.conf
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf

# Run as non-root: nginx:alpine has an 'nginx' user (uid 101)
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid

USER nginx
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/"]
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
